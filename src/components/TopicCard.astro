---
// One topic on the Notes page: a card that unfolds into its notes when clicked.
import type { Topic } from '../../site.config';
import { noteUrl, type Note } from '../lib/content';

interface Props {
  card: Topic & { notes: Note[] };
}
const { card } = Astro.props;

const count = (n: number) => `${n} ${n === 1 ? 'note' : 'notes'}`;
const first = card.about ? 1 : 0; // the notes come after the line about the topic

// Rows of the opened card: notes before the first section stay loose; each section is a fold
// of its own (closed at first) holding the notes from its `from` up to the next section
type Row = { note: Note } | { title: string; notes: Note[] };
const rows: Row[] = [];
for (const note of card.notes) {
  const section = card.sections?.find((s) => s.from === note.data.series?.order);
  const last = rows.at(-1);
  if (section) rows.push({ title: section.title, notes: [note] });
  else if (last && 'notes' in last) last.notes.push(note);
  else rows.push({ note });
}
---

<div class="topic" data-rv>
  <button class="topic-h" type="button" aria-expanded="false">
    <span class="top">
      <span class="type">{card.label ?? count(card.notes.length)}</span>
      {card.subject && <span class="subj">{card.subject}</span>}
    </span>
    <span class="row">
      <span class="name">
        <span class="ul">{card.title}</span>
      </span>
      <span class="go" aria-hidden="true">+</span>
    </span>
  </button>
  <div class="fold" inert>
    <ul>
      {
        card.about && (
          <li class="about" style="--i:0">
            <span>{card.about}</span>
          </li>
        )
      }
      {
        rows.map((row, i) =>
          'notes' in row ? (
            <li class="sect" style={`--i:${i + first}`}>
              <details>
                <summary>
                  <span>{row.title}</span>
                  <span class="sect-n">{count(row.notes.length)}</span>
                </summary>
                <ul>
                  {row.notes.map((note) => (
                    <li style="--i:0">
                      <a href={noteUrl(note)}>{note.data.title}</a>
                    </li>
                  ))}
                </ul>
              </details>
            </li>
          ) : (
            <li style={`--i:${i + first}`}>
              <a href={noteUrl(row.note)}>{row.note.data.title}</a>
            </li>
          ),
        )
      }
      {
        card.notes.length === 0 && (
          <li class="dim" style={`--i:${first}`}>
            <span>{card.empty ?? 'Nothing here yet.'}</span>
          </li>
        )
      }
    </ul>
  </div>
</div>
