---
// A tiny stand-alone page that sends an old address on to the current one.
import { site } from '../../site.config';

interface Props {
  to: string; // the current address, e.g. /posts/oil-markets-1-oil-basics/
}

const { to } = Astro.props;
const target = new URL(to, site.url).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>{site.name}</title>
    <meta http-equiv="refresh" content={`0;url=${to}`} />
    <link rel="canonical" href={target} />
    <meta name="robots" content="noindex" />
  </head>
  <body>
    <p>This page has moved. <a href={to}>Open it at its current address.</a></p>
  </body>
</html>
