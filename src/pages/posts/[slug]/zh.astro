---
// The Chinese version of a note, one step under the note's own address: /posts/<file-name>/zh/
import NoteView from '../../../components/NoteView.astro';
import { getNotes, getTranslations, type Note } from '../../../lib/content';

export async function getStaticPaths() {
  const translations = await getTranslations();
  return (await getNotes())
    .filter((note) => translations.has(note.id))
    .map((note) => ({ params: { slug: note.id }, props: { note } }));
}

interface Props {
  note: Note;
}

const { note } = Astro.props;
---

<NoteView note={note} lang="zh" />
