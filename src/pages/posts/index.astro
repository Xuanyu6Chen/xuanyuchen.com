---
// Notes: the same notes arranged three ways.
// By card: one card per topic; clicking a card unfolds its notes.
// By topic: the same cards, under the subject each one belongs to.
// By date: one list, newest first.
import Page from '../../layouts/Page.astro';
import TopicCard from '../../components/TopicCard.astro';
import { topics, type Topic } from '../../../site.config';
import { getNotes, notesIn, noteUrl, shortDate, topicOf, type Note } from '../../lib/content';

const notes = await getNotes();

// By card
const cards: (Topic & { notes: Note[] })[] = topics.map((topic) => ({
  ...topic,
  notes: notesIn(topic.id, notes),
}));
// A note that belongs to no listed topic still gets a home
const loose = notes.filter((note) => !topicOf(note));
if (loose.length > 0) cards.push({ id: 'other', title: 'Other notes', notes: loose });

// By subject, in the order the subjects first appear in site.config.ts
const subjectOf = (card: Topic) => card.subject ?? 'Other';
const subjects = [...new Set(cards.map(subjectOf))];
const inSubject = (subject: string) => cards.filter((card) => subjectOf(card) === subject);
const countCards = (n: number) => `${n} ${n === 1 ? 'card' : 'cards'}`;

// By date (getNotes already returns them newest first)
const years = [...new Set(notes.map((note) => note.data.pubDate.getUTCFullYear()))];
---

<Page title="Notes" name>
  <div class="sec" data-rv>
    <h2>Notes</h2>
    <div class="seg" role="group" aria-label="Arrange notes">
      <span class="seg-pill" aria-hidden="true"></span>
      <button class="seg-b" type="button" data-nv="topic" aria-pressed="true">By card</button>
      <button class="seg-b" type="button" data-nv="subject" aria-pressed="false">By topic</button>
      <button class="seg-b" type="button" data-nv="date" aria-pressed="false">By date</button>
    </div>
  </div>

  <div class="notes">
    <div class="topics">
      {cards.map((card) => <TopicCard card={card} />)}
    </div>

    <div class="subjects">
      {
        subjects.map((subject) => (
          <section class="subject" data-rv>
            <div class="subject-top">
              <h3 class="subject-h">{subject}</h3>
              <span class="subject-n">{countCards(inSubject(subject).length)}</span>
            </div>
            <div class="topics">
              {inSubject(subject).map((card) => <TopicCard card={card} />)}
            </div>
          </section>
        ))
      }
    </div>

    <div class="dates">
      {
        years.map((year) => (
          <section class="yr" data-rv>
            <h3 class="yr-h">{year}</h3>
            <ul class="rows">
              {notes
                .filter((note) => note.data.pubDate.getUTCFullYear() === year)
                .map((note) => (
                  <li>
                    <a class="rowl" href={noteUrl(note)}>
                      <time class="row-d" datetime={note.data.pubDate.toISOString()}>
                        {shortDate(note.data.pubDate)}
                      </time>
                      <span class="row-t">
                        <span class="ul">{note.data.title}</span>
                      </span>
                      {topicOf(note) && <span class="type">{topicOf(note)?.title}</span>}
                    </a>
                  </li>
                ))}
            </ul>
          </section>
        ))
      }
    </div>
  </div>
</Page>
